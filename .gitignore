# Python
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# macOS
.DS_Store
**/.DS_Store

# Local runtime (regenerated when you run the app)
app/outputs/
app/uploads/
app/logs/
app/ssd_cache/
app/nasa_cache/
app/owner_access/

# Compiled C core (rebuilt on demand by app/cspeed.py / tools/build_cspeed.py)
app/_cspeed.so
app/_cspeed.dylib

# Local run caches / logs
runs/
app/session.json
app/admin_session.json

# Owner device telemetry stays local (privacy)
OWNER_SHARED_LOGS/

# Packaging
dist/
build/
*.app/
*.spec

# Editor
.idea/
.vscode/
*.swp

# local runtime accounts
app/accounts.json
app/session.json
app/admin_session.json

# NOTE: training weights + checkpoint + Train_SPIRE_Background.command
# are TRACKED on purpose (restored from past project history).

# Atomic-write temp debris (never ship half-written models/kernels)
*.tmp.npz
app/models/*.tmp.*

# SPIRE-Net fine-tune output (never commit fine-tuned weights — keep the
# shipped weights as the canonical state)
app/models/spire_net_finetuned.npz
app/models/spire_net_finetuned.json
app/models/holy_cnn_weights.npz
app/nn_finetune_cache/
app/holy_train_cache/
app/outputs/stack_runs/
app/outputs/holy_stack/
app/outputs/wj_derotate/

# Pre-refactor backups
*.bak_before_deadstrip

# Accuracy campaign outputs (regenerated; can be large)
runs/
image-search/
real_photos/
app/native/*.so
